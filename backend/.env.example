# Copy this file to .env and fill in your own API keys. This project requires your own OpenAI/Pinecone/Weaviate accounts — see README.md for details and estimated costs.

# ------------------------------
# App Settings
# ------------------------------
APP_NAME="Intelligent Contract Analysis Compliance Engine"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# ------------------------------
# API Settings
# ------------------------------
SECRET_KEY="dev-secret-key-change-in-production"
DATABASE_URL=postgresql+psycopg2://contractuser:contractpassword@localhost:5433/contracts
REDIS_URL=redis://localhost:6379/0

# ------------------------------
# LLM Providers
# ------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ------------------------------
# Vector Databases
# ------------------------------
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=contract-clauses
WEAVIATE_URL=https://your-cluster-url.weaviate.cloud
WEAVIATE_API_KEY=your-weaviate-api-key-here

# ------------------------------
# Upload Paths
# ------------------------------
UPLOAD_DIR=./data/uploads

# ------------------------------
# Optional / Reserved for Future Use
# ------------------------------
# The following variables are defined in config.py but not currently used by any active code path. They are reserved for planned features (cloud storage migration, model fine-tuning, experiment tracking).
# Safe to leave as placeholders or omit entirely.
COHERE_API_KEY=your-cohere-api-key-here
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=contract-uploads
WANDB_API_KEY=your-wandb-api-key
HF_TOKEN=your-hugging-face-token
